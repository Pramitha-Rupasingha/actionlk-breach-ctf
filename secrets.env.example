# =============================================================================
# ActionLK Breach — single source of truth for every flag / credential.
#
#   cp secrets.env.example secrets.env     <- then edit your copy
#
# Edit values in secrets.env, mirror the matching ones into .env, then run
# `python3 scripts/generate_assets.py` and `docker compose up -d --build`.
# secrets.env is git-ignored. NEVER commit real/final flags.
# =============================================================================

# ---- Stage 1 — The Public Trail (OSINT) --------------------------------------
STAGE1_EMPLOYEE_FIRST=Alex
STAGE1_EMPLOYEE_SURNAME=Example
STAGE1_FLAG=ACTIONLK{replace_me_stage1}

# ---- Stage 2 — The Encoded Note (Cryptography) -------------------------------
# The fully decoded string IS the flag.
STAGE2_FLAG=ACTIONLK{fwd_sample_note}
STAGE2_CAESAR_SHIFT=7
# The single word inside the Stage 2 flag that feeds the Stage 6 passphrase:
STAGE2_WORD=sample

# ---- Stage 3 — Front Door (Web) ----------------------------------------------
STAGE3_FLAG=ACTIONLK{replace_me_stage3}
STAGE3_DB_APP_PASSWORD=CHANGE_ME_app_pw
STAGE3_ADMIN_DB_PASSWORD=CHANGE_ME_admin_pw

# ---- Stage 4 — Sniffing the Wire (Networking) --------------------------------
STAGE4_FTP_USER=filesvc
STAGE4_FTP_PASSWORD=CHANGE_ME_ftp_pw
STAGE4_FLAG=ACTIONLK{CHANGE_ME_ftp_pw}

# ---- Stage 5 — Behind the Door (Web + Networking) ----------------------------
STAGE5_PARTIAL_FLAG=ACTIONLK{replace_me_stage5}
# LAN/bridge IP of the Ubuntu Server host as seen by Kali — required for FTP
# passive mode. Set this to your real VM IP before first boot.
PASV_ADDRESS=192.168.0.10

# ---- Stage 6 — The Vault (Cryptography capstone) ----------------------------
# Passphrase rule: <surname>_<word>, lowercase (surname from Stage 1, word from Stage 2)
STAGE6_PASSPHRASE=example_sample
STAGE6_FLAG=ACTIONLK{replace_me_stage6}
