# docker-compose reads THIS file automatically (must be named .env, in the
# project root, next to docker-compose.yml).
#
#   cp .env.example .env     <- then edit your copy; .env is git-ignored
#
# Keep the STAGE*/PASV values identical to secrets.env.

CTFD_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
CTFD_DB_PASSWORD=CHANGE_ME_ctfd_db_pw
CTFD_DB_ROOT_PASSWORD=CHANGE_ME_ctfd_root_pw

STAGE3_DB_APP_PASSWORD=CHANGE_ME_app_pw
STAGE3_ADMIN_DB_PASSWORD=CHANGE_ME_admin_pw
STAGE3_FLAG=ACTIONLK{replace_me_stage3}

STAGE4_FTP_USER=filesvc
STAGE4_FTP_PASSWORD=CHANGE_ME_ftp_pw

# Your Ubuntu Server VM's real LAN/bridge IP (needed for FTP passive mode).
PASV_ADDRESS=192.168.0.10
